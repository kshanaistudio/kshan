# KSHAN Environment Configuration Template
# Copy this to .env or paste these into AWS App Runner / Cloud Console Environment Variables

# Django Configuration
DEBUG=False
DJANGO_SECRET_KEY=change-this-to-a-secure-random-secret-key-for-production
PYTHON_VERSION=3.11.8

# Cloudflare R2 / AWS S3 Storage (Required for persistent photo storage in serverless)
R2_ENABLED=True
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=kshan
R2_ENDPOINT_URL=

# Razorpay Payment Gateway (Optional / for billing)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_CURRENCY=INR

# Firebase Authentication (Optional)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Meta WhatsApp Cloud API (Optional)
META_WA_PHONE_NUMBER_ID=
META_WA_ACCESS_TOKEN=
META_WA_API_VERSION=v21.0
META_WA_OTP_TEMPLATE_NAME=
