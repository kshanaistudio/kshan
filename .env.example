# KSHAN Environment Configuration Template
# Copy this file to .env and configure with your specific environment credentials

# ================= Django Configuration =================
DEBUG=False
DJANGO_SECRET_KEY=replace-with-a-secure-random-secret-key-at-least-50-chars
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com
PYTHON_VERSION=3.11.9

# ================= Database Configuration =================
# Leave blank for local SQLite (development only)
# Format: postgresql://user:password@host:5432/dbname
DATABASE_URL=

# ================= Cloudflare R2 / AWS S3 Storage =================
R2_ENABLED=False
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT_URL=

# ================= Razorpay Payment Gateway =================
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_CURRENCY=INR

# ================= Meta WhatsApp Cloud API =================
META_WA_PHONE_NUMBER_ID=
META_WA_ACCESS_TOKEN=
META_WA_API_VERSION=v21.0
META_WA_OTP_TEMPLATE_NAME=

# ================= Firebase / OAuth =================
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# ================= Redis & Celery Configuration =================
REDIS_URL=redis://127.0.0.1:6379/0

# ================= WebRTC STUN/TURN Server =================
WEBRTC_STUN_URL=stun:stun.l.google.com:19302
WEBRTC_TURN_URL=
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_CREDENTIAL=

# ================= Face Recognition Pipeline =================
INSIGHTFACE_MODEL=buffalo_s
